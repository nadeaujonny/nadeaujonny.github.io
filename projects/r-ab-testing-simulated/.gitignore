# R session / IDE
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# OS noise
.DS_Store
Thumbs.db

# Raw data should not be tracked (keep .gitkeep)
data/raw/*
!data/raw/.gitkeep

# Optional: processed data can be tracked; if you prefer to ignore it, uncomment this:
# data/processed/*
# !data/processed/.gitkeep

# Rendered outputs (keep source)
reports/*.html
reports/*.pdf
reports/*.docx

# Temporary files
*.log
*.tmp
*.bak
*~
**/.Rproj.user/
**/.DS_Store
**/.Rhistory
