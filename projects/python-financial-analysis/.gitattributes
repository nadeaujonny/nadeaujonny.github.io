# Auto detect text files and normalize line endings
* text=auto

# Force specific file types to always use LF line endings
*.py text eol=lf
*.ipynb text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.gitignore text eol=lf

# Mark generated files as binary (won't show diffs)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
